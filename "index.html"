<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Islands of the Philippines</title>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, Helvetica, sans-serif;
}

html{
    scroll-behavior:smooth;
}

body{
    background:#eef8f7;
    color:#173f46;
}

/* NAVIGATION */

nav{
    position:fixed;
    top:0;
    left:0;
    width:100%;
    z-index:1000;

    display:flex;
    justify-content:space-between;
    align-items:center;

    padding:18px 7%;

    background:rgba(0,45,55,.92);
    backdrop-filter:blur(10px);

    color:white;
}

.logo{
    font-size:25px;
    font-weight:bold;
}

.logo span{
    color:#55e6d1;
}

nav a{
    color:white;
    text-decoration:none;
    margin-left:25px;
    font-weight:bold;
}

nav a:hover{
    color:#55e6d1;
}

/* HERO */

.hero{
    min-height:100vh;

    background:
    linear-gradient(
        rgba(0,35,45,.45),
        rgba(0,35,45,.65)
    ),
    url("https://commons.wikimedia.org/wiki/Special:Redirect/file/Tropical_lagoon_in_Bacuit_Bay,_El_Nido,_Palawan,_Philippines.jpg");

    background-size:cover;
    background-position:center;

    display:flex;
    align-items:center;
    justify-content:center;

    text-align:center;
    color:white;

    padding:30px;
}

.hero-content{
    max-width:900px;
}

.hero h1{
    font-size:clamp(45px,8vw,90px);
    text-shadow:0 5px 20px rgba(0,0,0,.5);
}

.hero p{
    font-size:20px;
    margin:20px auto;
    line-height:1.7;
}

.button{
    display:inline-block;
    padding:15px 30px;
    background:#55e6d1;
    color:#063b42;
    border-radius:30px;
    text-decoration:none;
    font-weight:bold;
    margin-top:10px;
    transition:.3s;
}

.button:hover{
    transform:translateY(-5px);
    background:white;
}

/* INTRO */

.intro{
    padding:80px 8%;
    text-align:center;
}

.intro h2{
    font-size:40px;
    margin-bottom:20px;
}

.intro p{
    max-width:800px;
    margin:auto;
    line-height:1.8;
    color:#507177;
}

/* SEARCH */

.controls{
    padding:20px 8%;
    display:flex;
    flex-wrap:wrap;
    gap:15px;
    justify-content:center;
}

input,
select{
    padding:14px 20px;
    border:2px solid #b7dfdb;
    border-radius:30px;
    outline:none;
    font-size:15px;
}

input{
    width:min(400px,90%);
}

/* ISLAND GRID */

.container{
    width:86%;
    max-width:1400px;
    margin:auto;
}

.islands{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
    gap:28px;
    padding:40px 0 100px;
}

/* CARD */

.card{
    background:white;
    border-radius:25px;
    overflow:hidden;

    box-shadow:
        0 10px 30px rgba(0,70,80,.12);

    transition:.4s;

    position:relative;
}

.card:hover{
    transform:translateY(-12px);
    box-shadow:
        0 20px 45px rgba(0,70,80,.22);
}

.card img{
    width:100%;
    height:230px;
    object-fit:cover;
    display:block;
    transition:.5s;
}

.card:hover img{
    transform:scale(1.08);
}

.image-box{
    overflow:hidden;
    position:relative;
}

.region{
    position:absolute;
    top:15px;
    left:15px;

    background:rgba(0,40,50,.8);
    color:white;

    padding:8px 13px;
    border-radius:20px;

    font-size:12px;
    font-weight:bold;
}

.card-content{
    padding:22px;
}

.card h3{
    font-size:24px;
    margin-bottom:8px;
}

.location{
    color:#17a89c;
    font-weight:bold;
    margin-bottom:12px;
}

.card p{
    color:#657b80;
    line-height:1.6;
}

.explore{
    display:inline-block;
    margin-top:18px;

    text-decoration:none;
    color:#087d79;

    font-weight:bold;
}

/* FEATURE */

.feature{
    width:86%;
    max-width:1200px;
    margin:0 auto 100px;

    display:grid;
    grid-template-columns:1fr 1fr;

    background:#073e46;
    color:white;

    border-radius:30px;
    overflow:hidden;

    box-shadow:0 20px 50px rgba(0,50,60,.25);
}

.feature img{
    width:100%;
    height:100%;
    min-height:400px;
    object-fit:cover;
}

.feature-text{
    padding:50px;
    display:flex;
    flex-direction:column;
    justify-content:center;
}

.feature-text h2{
    font-size:42px;
    margin-bottom:20px;
}

.feature-text p{
    line-height:1.8;
    color:#d3eeee;
}

/* FACTS */

.facts{
    padding:90px 8%;
    background:#dff4f1;
    text-align:center;
}

.facts h2{
    font-size:40px;
    margin-bottom:40px;
}

.fact-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(200px,1fr));
    gap:20px;
    max-width:1000px;
    margin:auto;
}

.fact{
    background:white;
    padding:30px;
    border-radius:20px;
}

.fact strong{
    display:block;
    font-size:35px;
    color:#0a9188;
}

.fact span{
    color:#5e7478;
}

/* FOOTER */

footer{
